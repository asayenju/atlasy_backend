# Required: Supabase → Project Settings → API → JWT Secret (not the anon/service keys)
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Optional: enforce issuer claim. Example:
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWT_ISSUER=

# CORS: comma-separated origins for Expo / web dev (add your LAN IP for physical device testing)
# Example: http://192.168.1.10:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:19006
